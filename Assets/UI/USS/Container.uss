:root {
}

.containeritem__grid-cell {
    position: relative;
    width: 46px;
    height: 46px;
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
    background-color: rgba(0, 0, 0, 0.2);
    background-image: url("project://database/Assets/UITest/GridCell.png?fileID=2800000&guid=5773353070be94995987ad1f453a6315&type=3#GridCell");
}

.containeritem__grid-cell:hover {
    position: relative;
    width: 46px;
    height: 46px;
    background-color: rgb(255, 211, 0);
    margin-top: 1px;
    margin-right: 1px;
    margin-bottom: 1px;
    margin-left: 1px;
}

.containeritem__header {
    width: 100%;
    height: 20px;
    margin-bottom: 20px;
    background-color: rgba(0, 0, 0, 0.39);
    align-items: center;
    justify-content: center;
}

.containeritem__header-text {
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.containeritem__gridblock {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-self: center;
    align-content: auto;
    position: relative;
    justify-content: center;
}

.containeritem__body {
    align-items: center;
    align-self: center;
    align-content: auto;
}

.containeritem__root {
    margin-bottom: 20px;
    width: 100%;
}

.containeritem__root:hover {
    margin-bottom: 20px;
    width: 100%;
    background-color: rgb(252, 255, 0);
}

.containeritem__gridblock-cellparent {
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: center;
    align-content: auto;
    width: 290px;
    flex-shrink: 0;
}

.containeritem__gridblock-cellparent:hover {
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: center;
    align-content: auto;
    width: 290px;
    flex-shrink: 0;
    background-color: rgb(0, 48, 255);
}
