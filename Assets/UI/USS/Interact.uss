:root {
}

.interacticon {
    flex-direction: row;
    width: 120px;
    height: 42px;
    align-items: center;
    align-self: center;
    background-color: rgba(0, 255, 255, 0.2);
    translate: -50% -50%;
}

.interacticon__buttonicon {
    flex-grow: 0;
    height: 36px;
    width: 36px;
}

.interacticon__text {
    flex-grow: 0;
    height: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 4px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: center;
    align-self: center;
    align-content: center;
    -unity-text-align: middle-center;
    font-size: 28px;
    -unity-font-style: bold;
    justify-content: flex-start;
    color: rgb(64, 64, 64);
}
