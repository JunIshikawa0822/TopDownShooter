<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UITest/Container.uss?fileID=7433441132597879392&amp;guid=6bb4d475ad30e41a68373b4aac9a3a05&amp;type=3#Container" />
    <Style src="project://database/Assets/UITest/Inventory.uss?fileID=7433441132597879392&amp;guid=b33633997863f4c9cbe3712c7d36de2a&amp;type=3#Inventory" />
    <ui:VisualElement name="containeritem" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.2); width: 100%; height: 100%;">
        <ui:VisualElement name="containeritem__header" style="flex-grow: 0; height: 20px; background-color: rgba(0, 0, 0, 0.39); justify-content: center; flex-direction: column; align-items: center; margin-bottom: 5px; width: 100%;">
            <ui:Label text="Player" name="containeritem__name" class="containeritem__header-text" style="font-size: 20px; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(255, 255, 255); padding-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="containeritem__body" style="flex-grow: 1; align-items: center; align-self: auto; flex-direction: column; width: 100%; height: 100%;">
            <ui:VisualElement name="containeritem__container" style="flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
