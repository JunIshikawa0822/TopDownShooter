:root {
}

.containeritem__header {
    width: 100%;
    height: 20px;
    margin-bottom: 20px;
    background-color: rgba(0, 0, 0, 0.39);
    align-items: center;
    justify-content: center;
}

.containeritem__header-text {
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.containeritem__gridblock {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    align-self: center;
    align-content: auto;
    position: relative;
    justify-content: center;
}

.containeritem__body {
    align-items: center;
    align-self: center;
    align-content: auto;
}

.containeritem__root {
    margin-bottom: 20px;
    width: 100%;
}

.containeritem__gridblock-cellparent {
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-self: center;
    align-content: auto;
    width: 290px;
    flex-shrink: 0;
}
